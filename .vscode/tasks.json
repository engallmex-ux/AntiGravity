{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "⚡ AUTO SYNC (GitHub)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File .\\sync.ps1",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
